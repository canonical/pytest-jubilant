# The SDK's whole job is installing these, so check that they all arrived: a
# failed apt-get or a failed installer is otherwise invisible until someone
# tries to use the harness or run an action. node and npm are system packages,
# but `pi` and `tox` go into the workshop user's own prefixes, so look for them
# as that user.
if node --version >/dev/null 2>&1 &&
    npm --version >/dev/null 2>&1 &&
    sudo -iu workshop sh -c 'command -v pi' >/dev/null 2>&1 &&
    sudo -iu workshop sh -c 'command -v tox' >/dev/null 2>&1; then
    workshopctl set-health okay
else
    workshopctl set-health error
fi
